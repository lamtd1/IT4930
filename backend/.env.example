# =============================================================================
# Semantic Book Recommender — Backend Environment Variables
# Copy this file to .env and adjust if needed.
# =============================================================================

# CORS — allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Paths (relative to backend/ directory)
# -----------------------------------------------------------------------------
DATASET_PATH=../AI/data/processed/books_with_emotions.csv
CHROMA_PATH=../AI/data/chroma_db
EVAL_FINAL_JSON=../AI/reports/evaluation_final.json
EVAL_RESULTS_JSON=../AI/data/eval/evaluation_results.json

# Model artifacts (created by init_models.py)
BM25_INDEX_PATH=../AI/models/bm25.pkl
TFIDF_MODEL_PATH=../AI/models/tfidf.pkl
TFIDF_MATRIX_PATH=../AI/models/tfidf_matrix.npz

# -----------------------------------------------------------------------------
# AI Model Configuration
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
CHROMA_COLLECTION_NAME=books

# Maximum books to process (set high to use full dataset)
MAX_BOOKS_TO_PROCESS=15000
